{
  "profile": "normal",
  "model": {
    "path": "D:\\DAVYAN\\models\\Qwen2.5-0.5B-Instruct",
    "max_new_tokens": 48,
    "cpu_threads": 4
  },
  "activity": {
    "active_within_seconds": 300,
    "poll_interval_ms": 1000
  },
  "application_awareness": {
    "enabled": true,
    "max_applications": 5
  },
  "gaming_mode": {
    "enabled": true,
    "poll_interval_ms": 1000,
    "excluded_processes": [
      "Code",
      "chrome",
      "firefox",
      "msedge",
      "explorer",
      "Photoshop",
      "Premiere",
      "KMPlayer",
      "vlc",
      "mpv",
      "PowerPoint"
    ]
  },
  "chat": {
    "memory_messages": 10
  },
  "time_behavior": {
    "enabled": true,
    "poll_interval_ms": 30000,
    "path": "data/mina_behavior.sqlite3",
    "cooldown_seconds": [1800, 3600],
    "delay_seconds": [15, 90],
    "rules": [
      {
        "id": "system_startup",
        "name": "the computer has started up",
        "type": "startup",
        "priority": 100
      },
      {
        "id": "uptime_12_hours",
        "name": "the computer has been on for 12 hours",
        "type": "uptime",
        "hours": 12,
        "priority": 90
      },
      {
        "id": "uptime_6_hours",
        "name": "the computer has been on for 6 hours",
        "type": "uptime",
        "hours": 6,
        "priority": 80
      },
      {
        "id": "uptime_2_hours",
        "name": "the computer has been on for 2 hours",
        "type": "uptime",
        "hours": 2,
        "priority": 70
      },
      {
        "id": "late_night",
        "name": "it is late at night",
        "type": "time_range",
        "start": "00:00",
        "end": "05:00",
        "priority": 60
      },
      {
        "id": "no_interaction_30_minutes",
        "name": "there has been no user interaction for 30 minutes",
        "type": "no_interaction",
        "seconds": 1800,
        "exclusive_group": "inactivity",
        "priority": 50
      },
      {
        "id": "idle_20_minutes",
        "name": "Windows has been idle for 20 minutes",
        "type": "idle",
        "seconds": 1200,
        "exclusive_group": "inactivity",
        "priority": 40
      },
      {
        "id": "time_period_change",
        "name": "the time of day has changed",
        "type": "time_period",
        "priority": 30
      },
      {
        "id": "new_day",
        "name": "a new day has begun",
        "type": "new_day",
        "priority": 20
      },
      {
        "id": "long_silence",
        "name": "Mina has not spoken in four hours",
        "type": "since_spoke",
        "seconds": 14400,
        "priority": 10
      }
    ]
  },
  "scheduler": {
    "enabled": true,
    "state_path": "data/mina_scheduler.sqlite3"
  },
  "dataset": {
    "path": "data/mina.sqlite3"
  },
  "profiles": {
    "normal": {
      "interval_seconds": [1800, 3600],
      "cooldown_seconds": [1800, 2700],
      "daily_limit": 8
    }
  },
  "emoji_peek": {
    "chance": 0.2,
    "corner": "bottom_right"
  },
  "emoji": {
    "directory": "assets/emojis/animations",
    "mapping": "assets/emojis/moods.json",
    "scale": 2,
    "keywords": {
      "potato": "Cute",
      "gravity": "Dizzy",
      "why": "Question",
      "oops": "Sweat",
      "moon": "Sleepy",
      "tiny": "Cute",
      "idea": "Idea",
      "ha": "Laughing"
    }
  },
  "ui": {
    "font": "Mojangles",
    "font_path": "assets/fonts/mojangles.otf",
    "register_font": true,
    "persian_fallback": "Segoe UI",
    "persian_fallback_path": "%WINDIR%\\Fonts\\segoeui.ttf",
    "emoji_scale": 1,
    "companion_size": [280, 84]
  },
  "popup": {
    "size": [420, 142],
    "message_font_size": 16,
    "typewriter_ms": 45,
    "hold_ms": 8000,
    "mute_header_right_padding": 16,
    "animation": {
      "slide_ms": 200,
      "peek_duration_ms": 8000
    }
  },
  "sound": {
    "dialogue_mode": "animalese",
    "animalese": {
      "enabled": true,
      "files": ["assets/sounds/dialogue_blip.wav"],
      "volume": 55,
      "playback_speed": 1.0,
      "character_interval_ms": 70
    },
    "typing": {
      "enabled": true,
      "path": "assets/sounds/typing.wav",
      "volume": 35
    },
    "click": {
      "enabled": false,
      "path": null,
      "volume": 40
    }
  }
}
